<!DOCTYPE html>
<html lang="en">
<%- include("partials/header") %>
<script src="/js/carousel.js"></script>
<script src="/css/style.css"></script>

<body class="bg-white text-black  min-h-screen">
<%- include("partials/nav") %>
    <div class="bg-[url('/images/background.png')] bg-cover rounded-xl max-w-5xl mx-auto px-6 py-4">
        <h1 class="text-3xl font-bold">Select Ingredients:</h1>
            <p class="text-gray-500">Choose What You Have On Hand</p>


        <% data.ingredients.forEach((category) => { %>

            <section class="ingredient-section mb-10">

                <h1 class="text-2xl font-bold">
                    <%= category.name %>
                </h1>

                <p class="text-gray-500 mb-4">
                    <%= category.description %>
                </p>

                <div class="flex gap-2 mb-3">
                    <button type="button" class="carousel-prev">Previous</button>
                    <button type="button" class="carousel-next">Next</button>
                </div>

                <div class="ingredient-carousel flex gap-4 overflow-x-auto snap-x snap-mandatory scroll-smooth">

                    <% category.items.forEach((item) => { %>

                        <button class="relative shrink-0 w-40 sm:w-52 aspect-square snap-start rounded-xl overflow-hidden">

                            <img
                                src="<%= item.img %>"
                                alt="<%= item.name %>"
                                class="w-full h-full object-cover"
                            >

                            <div class="absolute bottom-0 left-0 w-full bg-black/60 p-3 text-center">
                                <span class="text-white font-semibold">
                                    <%= item.name %>
                                </span>
                            </div>

                        </button>

                    <% }); %>

                </div>

            </section>

        <% }); %>

    </main>
<%- include("partials/footer") %>
</body>
</html>
